# ============================================================================
# alpaca-0DTE Configuration Template
#
# Usage:
#   Copy this file to .env and populate your credentials:
#   `cp .env.example .env`
#
# Notice:
#   .env is strictly listed in .gitignore and should NEVER be committed.
#   Only variables actively consumed by the codebase are declared below.
# ============================================================================

# ── Database (Local SQLite3 by Default) ──────────────────────────────────────
# The engine uses a zero-configuration, self-contained local SQLite3 database.
# Default storage path is data/trading.db. Tables and seed data initialize automatically.
# Optional custom database path (uncomment to override):
# SQLITE_DB_PATH=data/trading.db


# ── Alpaca (Execution & Market Data) ────────────────────────────────────────
# Alpaca Paper / Live API credentials
# Compatible key names: ALAPCA_AKEY, ALPACA_AKEY, or ACCESS_KEY
ALAPCA_AKEY=
ALPACA_SKEY=

# ── Unusual Whales (GEX, Gamma Levels & Market Tide) ────────────────────────
# Primary relay endpoint (recommended) with official direct endpoint fallback
UW_T_ENDPOINT=
UW_T_KEY=
UW_ENDPOINT=https://api.unusualwhales.com
UW_API_KEY=

# ── Massive.com ─────────────────────────────────────────────────────────────
MASSIVE_API_KEY=

# ── Network Proxies ─────────────────────────────────────────────────────────
# Outgoing market data API requests adhere strictly to configured proxies.
# Values in .env take precedence over system environment variables.
# Format: host:port (http:// prefix will be automatically attached if omitted)
HTTP_PROXY=
SOCKS5_PROXY=

# SOCKS5 proxy URL for Alpaca SDK connections (Scheme required, e.g. socks5h://127.0.0.1:1080)
ALPACA_PROXY_URL=

# ── Data Source Switch ──────────────────────────────────────────────────────
# Options:
#   Empty / omitted : Live Alpaca feed
#   mock            : Local playback server for replaying market sessions
DATA_SOURCE=
# Required only when DATA_SOURCE=mock:
# ALPACA_END_POINT=http://127.0.0.1:9000
# MOCK_STREAM_URL=

# ── Runtime & Debug Flags ───────────────────────────────────────────────────
# TT_RELOAD=1              # Enable FastAPI auto-reload during development
# TT_DISABLE_FILE_LOG=1    # Disable file logging and direct outputs to console only
# TT_BAR_CACHE=            # Directory path for caching historical OHLCV bars
